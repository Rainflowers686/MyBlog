# Reference only: export these variables in your shell or process manager.
# MyBlog does not automatically load this file.
# Generate DJANGO_SECRET_KEY with secrets.token_urlsafe(64); do not reuse an old key.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=my_blog_db
DB_USER=myblog
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Webmaster <webmaster@localhost>
# Keep disabled. Only an isolated local demonstration may set BOTH DEBUG=1 and this=1.
MYBLOG_DEMO_PASSWORD_RESET=0
